<!DOCTYPE html>
<head>
<title>Registration form</title>
</head>
<body style="background-color:pink;">
<form action="submit.html">
<center><h1>Registration Form</h1></center>

<p>Name:</p>
<input type="text" placeholder="First Name" required>
<input type="text" placeholder="Middle Name" required>
<input type="text" placeholder="Last Name" required>
<br>

<p>Date of Birth:</p>
<input type="date" placeholder="Birthdate" required>
<br>

<p>Mobile No.:</p>
<input type="tel" placeholder="Mobile no." required>
<br>

<p>Address :</p>
<input type="text" placeholder="Address" required>
<br>

<p>College Name :</p>
<input type="text" placeholder="College name" required>
<br>

<p>Select Branch :</p>
<select>
<option>Select Branch</option>
<option>CSE</option>
<option>AIML</option>
<option>DS</option>
<option>Mechanical</option>
<option>Electrical</option>
<option>Civil</option>
<option>Chemical</option>
<option>ENTC</option>
</select>
<br>

<p style="color:blue;">Technical Skills :</p>
<input type="checkbox">c<br>
<input type="checkbox">c++<br>
<input type="checkbox">Java<br>
<input type="checkbox">Python<br>
<input type="checkbox">Html<br>
<input type="checkbox">Css<br>
<input type="checkbox">Javascript<br>
<input type="checkbox">SQL<br>
<input type="checkbox">MongoDB<br>
<br>

<input type="radio" name="gender" value="Male">Male<br>
<input type="radio" name="gender" value="Female">Female<br>

<button type="submit" value="submit">Submit</button>
</form>
</body>
</html>
